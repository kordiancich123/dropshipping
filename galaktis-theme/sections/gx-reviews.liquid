{%- comment -%}
  Opinie i social proof.
  Zasady uczciwości (wbudowane w sekcję):
  * ocena i liczba opinii pokazują się tylko, gdy je wpiszesz;
  * „Zweryfikowany zakup” tylko przy potwierdzonym zamówieniu w Twoim sklepie;
  * zdjęcie w galerii jest podpisane jako zdjęcie klienta tylko, gdy zaznaczysz „Zdjęcie klienta”;
    pozostałe są podpisane jako wizualizacje;
  * opinia bez treści nie wyświetla się klientom; w edytorze widać [REAL REVIEW REQUIRED].
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign photos = section.blocks | where: 'type', 'photo' -%}
{%- assign reviews = section.blocks | where: 'type', 'review' -%}
{%- assign n_customer = 0 -%}
{%- for b in photos -%}{%- if b.settings.customer -%}{%- assign n_customer = n_customer | plus: 1 -%}{%- endif -%}{%- endfor -%}
<section class="gx-sec gx-sec--alt gx-sp" id="opinie" aria-labelledby="gx-rev-h">
  <div class="gx-w">
    <div class="gx-head gx-reveal">
      <span class="gx-eyebrow">{{ s.eyebrow }}</span>
      <h2 class="gx-h2" id="gx-rev-h">{{ s.heading }}</h2>
      {%- if s.rating != blank -%}
        <div class="gx-sp__sum">{% render 'gx-stars' %}<b>{{ s.rating }}/5</b>{% if s.count != blank %}<span>{{ s.count }} opinii</span>{% endif %}</div>
      {%- elsif request.design_mode -%}
        <div class="gx-sp__sum gx-sp__req">[PRAWDZIWA OCENA] · [PRAWDZIWA LICZBA OPINII]</div>
      {%- endif -%}
      {%- if s.lead != blank -%}<p class="gx-lead">{{ s.lead }}</p>{%- endif -%}
    </div>

    {%- comment -%} Wyróżniona opinia {%- endcomment -%}
    <div class="gx-sp__feat gx-reveal">
      <div class="gx-sp__media">
        {% render 'gx-img', image: s.feat_image, alt: s.feat_alt, ph: 'SYPIALNIA NOCĄ, PROJEKCJA NA SUFICIE, 4:5', sizes: '(min-width:1000px) 560px, 100vw' %}
        {%- if s.feat_video != blank -%}
          {%- assign mp4 = s.feat_video.sources | where: 'format', 'mp4' | sort: 'height' | last -%}
          {%- if mp4 -%}<video class="gx-sp__video" muted loop playsinline preload="none" aria-hidden="true" data-gx-lazy-video="{{ mp4.url }}"></video>{%- endif -%}
        {%- endif -%}
        {%- if s.feat_caption != blank -%}<span class="gx-sp__badge">{{ s.feat_caption }}</span>{%- endif -%}
      </div>
      <div class="gx-sp__quote">
        {%- if s.feat_text != blank -%}
          {% render 'gx-stars', count: s.feat_stars %}
          <blockquote>„{{ s.feat_text }}”</blockquote>
          <div class="gx-sp__who"><b>{{ s.feat_name }}</b>{% if s.feat_date != blank %} · {{ s.feat_date }}{% endif %}{% if s.feat_verified %}<span class="gx-sp__ok">✓ Zweryfikowany zakup</span>{% endif %}</div>
          {%- if s.feat_source != blank -%}<p class="gx-sp__src">{{ s.feat_source }}</p>{%- endif -%}
        {%- else -%}
          {%- if request.design_mode -%}<p class="gx-sp__req">[REAL REVIEW REQUIRED] Wpisz tu prawdziwą opinię klienta, imię, datę. Do tego czasu klienci widzą tekst poniżej.</p>{%- endif -%}
          <h3 class="gx-sp__h3">{{ s.feat_fallback_title }}</h3>
          <p class="gx-sp__p">{{ s.feat_fallback_text }}</p>
        {%- endif -%}
        {%- if s.cta_label != blank -%}<a class="gx-btn gx-btn--primary" href="{{ s.cta_link | default: '#produkt' }}">{{ s.cta_label }} <span aria-hidden="true">→</span></a>{%- endif -%}
      </div>
    </div>

    {%- comment -%} Galeria zdjęć {%- endcomment -%}
    {%- if photos.size > 0 -%}
    <div class="gx-sp__gal-head gx-reveal">
      <h3 class="gx-sp__h3">{% if n_customer > 0 %}{{ s.gal_title_customers }}{% else %}{{ s.gal_title }}{% endif %}</h3>
      {%- if n_customer == 0 and s.gal_note != blank -%}<p class="gx-sp__p">{{ s.gal_note }}</p>{%- endif -%}
    </div>
    <ul class="gx-sp__gal" role="list">
      {%- for b in photos -%}
      <li class="gx-sp__tile" {{ b.shopify_attributes }}>
        {% render 'gx-img', image: b.settings.image, alt: b.settings.caption, ph: '[REAL CUSTOMER PHOTO REQUIRED]', sizes: '(min-width:1000px) 190px, 42vw', widths: '240,360,480,600' %}
        <span class="gx-sp__cap">{% if b.settings.customer %}{{ b.settings.name | default: 'Zdjęcie klienta' }}{% else %}{{ b.settings.caption }}{% endif %}</span>
      </li>
      {%- endfor -%}
    </ul>
    {%- endif -%}

    {%- comment -%} Karuzela opinii {%- endcomment -%}
    <div class="gx-sp__car-head gx-reveal">
      <h3 class="gx-sp__h3">{{ s.car_title }}</h3>
      <div class="gx-sp__nav"><button type="button" class="gx-sp__arr" data-gx-car-prev aria-label="Poprzednie opinie">←</button><button type="button" class="gx-sp__arr" data-gx-car-next aria-label="Następne opinie">→</button></div>
    </div>
    <div class="gx-sp__car" data-gx-car tabindex="0" aria-label="Opinie">
      {%- for b in reviews -%}
        {%- if b.settings.text != blank -%}
        <article class="gx-sp__card" {{ b.shopify_attributes }}>
          <div class="gx-sp__top">{% render 'gx-stars', count: b.settings.stars %}{% if b.settings.topic != blank %}<span class="gx-sp__tag">{{ b.settings.topic }}</span>{% endif %}</div>
          {%- if b.settings.objection != blank -%}<p class="gx-sp__obj">{{ b.settings.objection }}</p>{%- endif -%}
          <p class="gx-sp__txt">„{{ b.settings.text }}”</p>
          <div class="gx-sp__who"><b>{{ b.settings.name }}</b>{% if b.settings.date != blank %} · {{ b.settings.date }}{% endif %}{% if b.settings.verified %}<span class="gx-sp__ok">✓ Zweryfikowany zakup</span>{% endif %}</div>
          {%- if b.settings.source != blank -%}<p class="gx-sp__src">{{ b.settings.source }}</p>{%- endif -%}
        </article>
        {%- elsif request.design_mode -%}
        <article class="gx-sp__card gx-sp__card--req" {{ b.shopify_attributes }}>
          <span class="gx-sp__tag">{{ b.settings.topic }}</span>
          <p class="gx-sp__req">[REAL REVIEW REQUIRED]</p>
          <p class="gx-sp__obj">{{ b.settings.objection }}</p>
          <p class="gx-sp__src">Ukryte dla klientów, dopóki nie wpiszesz prawdziwej opinii.</p>
        </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if s.note != blank -%}<p class="gx-sp__note">{{ s.note }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Opinie",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Nadtytuł","default":"Opinie"},
    {"type":"text","id":"heading","label":"Nagłówek","default":"GALAKTIS w prawdziwych pokojach"},
    {"type":"text","id":"lead","label":"Opis"},
    {"type":"text","id":"rating","label":"Średnia ocena (np. 4,8). Puste = ukryte"},
    {"type":"text","id":"count","label":"Liczba opinii. Puste = ukryte"},
    {"type":"header","content":"Wyróżniona opinia"},
    {"type":"image_picker","id":"feat_image","label":"Duże zdjęcie (4:5)"},
    {"type":"text","id":"feat_alt","label":"Alt zdjęcia"},
    {"type":"video","id":"feat_video","label":"Wideo (opcjonalnie, bez dźwięku)"},
    {"type":"text","id":"feat_caption","label":"Podpis na zdjęciu","default":"Wizualizacja"},
    {"type":"textarea","id":"feat_text","label":"Treść prawdziwej opinii. Puste = tekst zastępczy"},
    {"type":"range","id":"feat_stars","label":"Gwiazdki","min":1,"max":5,"step":1,"default":5},
    {"type":"text","id":"feat_name","label":"Imię klienta"},
    {"type":"text","id":"feat_date","label":"Data opinii"},
    {"type":"checkbox","id":"feat_verified","label":"Zweryfikowany zakup w moim sklepie","default":false},
    {"type":"text","id":"feat_source","label":"Źródło opinii"},
    {"type":"text","id":"feat_fallback_title","label":"Tekst zastępczy: tytuł","default":"Tak to wygląda w ciemnym pokoju"},
    {"type":"textarea","id":"feat_fallback_text","label":"Tekst zastępczy: opis","default":"Jeden okrągły obraz na suficie, miękkie światło na ścianach i pościeli. Najwyraźniej w ciemnym pokoju."},
    {"type":"text","id":"cta_label","label":"Przycisk","default":"Odkryj GALAKTIS"},
    {"type":"url","id":"cta_link","label":"Link przycisku"},
    {"type":"header","content":"Galeria"},
    {"type":"text","id":"gal_title","label":"Tytuł galerii (same wizualizacje)","default":"GALAKTIS w różnych pokojach"},
    {"type":"text","id":"gal_title_customers","label":"Tytuł galerii (są zdjęcia klientów)","default":"Zdjęcia klientów"},
    {"type":"text","id":"gal_note","label":"Notka pod tytułem (gdy brak zdjęć klientów)","default":"Wizualizacje produktu. Zdjęcia od klientów dodamy tu po pierwszych zamówieniach."},
    {"type":"header","content":"Karuzela opinii"},
    {"type":"text","id":"car_title","label":"Tytuł","default":"Co mówią kupujący"},
    {"type":"textarea","id":"note","label":"Notka pod opiniami"}
  ],
  "blocks": [
    {"type":"photo","name":"Zdjęcie w galerii","settings":[
      {"type":"image_picker","id":"image","label":"Zdjęcie (4:5)"},
      {"type":"text","id":"caption","label":"Podpis / alt","default":"Wizualizacja"},
      {"type":"checkbox","id":"customer","label":"To prawdziwe zdjęcie klienta (mam zgodę)","default":false},
      {"type":"text","id":"name","label":"Imię klienta (tylko przy zdjęciu klienta)"}
    ]},
    {"type":"review","name":"Opinia","settings":[
      {"type":"select","id":"topic","label":"Temat","default":"Atmosfera","options":[
        {"value":"Atmosfera","label":"Atmosfera"},{"value":"Jakość","label":"Jakość"},{"value":"Łatwość użycia","label":"Łatwość użycia"},
        {"value":"Sypialnia","label":"Sypialnia"},{"value":"Prezent","label":"Prezent"},{"value":"Gaming","label":"Gaming"},{"value":"Pokój dziecięcy","label":"Pokój dziecięcy"}]},
      {"type":"text","id":"objection","label":"Na jaką obawę odpowiada"},
      {"type":"range","id":"stars","label":"Gwiazdki","min":1,"max":5,"step":1,"default":5},
      {"type":"textarea","id":"text","label":"Treść prawdziwej opinii. Puste = ukryta"},
      {"type":"text","id":"name","label":"Podpis"},
      {"type":"text","id":"date","label":"Data"},
      {"type":"checkbox","id":"verified","label":"Zweryfikowany zakup w moim sklepie","default":false},
      {"type":"text","id":"source","label":"Źródło"}
    ]}
  ]
}
{% endschema %}
