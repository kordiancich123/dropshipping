{%- assign s = section.settings -%}
<section class="gx-final" aria-labelledby="gx-fin-h">
  <div class="gx-final__bg">{% render 'gx-img', image: s.image, alt: '', ph: 'POKÓJ Z PROJEKCJĄ GALAKTYKI, 16:9', sizes: '100vw' %}</div>
  <div class="gx-final__in gx-reveal">
    <h2 id="gx-fin-h">{{ s.heading }}</h2>
    <p>{{ s.sub }}</p>
    <a href="{{ s.cta_link }}" class="gx-btn gx-btn--primary">{{ s.cta }} {% render 'gx-icon', name: 'arrow' %}</a>
  </div>
</section>
{% schema %}
{
  "name": "Końcowe CTA",
  "settings": [
    {"type":"image_picker","id":"image","label":"Zdjęcie tła"},
    {"type":"text","id":"heading","label":"Nagłówek","default":"Twój wieczór może wyglądać inaczej"},
    {"type":"text","id":"sub","label":"Podtytuł","default":"Stwórz własną galaktykę w kilka sekund."},
    {"type":"text","id":"cta","label":"Przycisk","default":"Odkryj GALAKTIS"},
    {"type":"text","id":"cta_link","label":"Link","default":"#produkt"}
  ]
}
{% endschema %}
